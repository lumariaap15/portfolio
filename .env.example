# Copy to .env.local (gitignored) and fill in real values.

# Resend API key, used by src/app/api/contact/route.ts to send the contact-form lead email.
# Get one at https://resend.com/api-keys — free tier is enough to start.
RESEND_API_KEY=

# Cloudflare Turnstile keys, used by the contact form (site key) and src/app/api/contact/route.ts (secret).
# Get them at https://dash.cloudflare.com/?to=/:account/turnstile — free.
# For local testing you can use Cloudflare's always-pass test keys:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
